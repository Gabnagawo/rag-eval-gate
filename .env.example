# Copy to .env (gitignored). Every value is optional; the defaults use local Ollama.

# Generator (the model under test): ollama (default) | anthropic | openai
LLM_PROVIDER=ollama
# Overrides the profile's generator_model from eval.yaml
# LLM_MODEL=qwen3:8b
# Judge for RAGAS and DeepEval (always Ollama); overrides the profile's judge_model
# JUDGE_MODEL=qwen3:8b
# EMBED_MODEL=nomic-embed-text

OLLAMA_HOST=http://localhost:11434
# Keep the same num_ctx as other clients of a shared Ollama, or it reloads the model.
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false
# Unload the model after a failed completion, so the retry gets a new runner.
OLLAMA_RELOAD_ON_FAULT=true
LLM_TIMEOUT_S=300
LLM_RETRIES=4
LLM_SEED=42

# Only for LLM_PROVIDER=anthropic (uv sync --extra anthropic); default model claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=openai (uv sync --extra openai); set LLM_MODEL too
OPENAI_API_KEY=
